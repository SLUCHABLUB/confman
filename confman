# Start of Public API

# Adds a repository.
#
# Parameters:
# - Name (only the ascii letters, hyphen, and underscore are allowed)
# - Local path (newlines not allowed currently)
# - Git url (will be cloned to the local path)
add_repository() {
    if [ $# != 0 ]; then
        echo 'error: add_repository takes 2 or 3 arguments' >&2
        return 1
    fi

    # TODO: Validate the arguments.

    printf '%s %s %s\n' "$1" "$2" "$3"
}

# End of Public API
